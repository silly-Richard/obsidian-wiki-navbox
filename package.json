{
  "name": "obsidian-wiki-navbox",
  "version": "1.0.0",
  "description": "A Wikipedia-style collapsible navbox for Obsidian.",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch --skip-typecheck",
    "preview": "node scripts/build.mjs --skip-typecheck",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs"
