  "keywords": [
    "obsidian",
    "plugin",
    "navbox",
    "wikipedia"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "js-yaml": "^5.5.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.7.0"
  }
}
